{
  "name": "kwami-ai",
  "version": "0.0.1",
  "description": "3D AI companion library with voice, memory, and tools",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "keywords": [
    "ai",
    "voice",
    "agent",
    "companion",
    "3d",
    "threejs",
    "livekit",
    "mcp"
  ],
  "author": "Alex Colls",
  "license": "Apache-2.0",
  "dependencies": {
    "livekit-client": "^2.23.0",
    "simplex-noise": "^4.0.3",
    "three": ">=0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^9.18.0",
    "globals": "^17.14.0",
    "jiti": "2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "three": ">=0.187.0"
  }
}
